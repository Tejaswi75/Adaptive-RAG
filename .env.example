# Required
GROQ_API_KEY=your_groq_api_key          # https://console.groq.com/keys
TAVILY_API_KEY=your_tavily_api_key      # https://app.tavily.com (web search)

# Optional
GROQ_MODEL=llama-3.3-70b-versatile     # any chat model your Groq project can access

# MONGO_URI=mongodb+srv://...           # chat history; leave unset to keep it in memory
BACKEND_URL=http://127.0.0.1:8000       # where Streamlit reaches the FastAPI backend
MAX_REWRITES=2                          # query rewrites before falling back to web search
ENABLE_GRADER=true                      # set false to skip grading (evaluation ablation)
LOG_LEVEL=INFO                          # DEBUG shows retrieved context
